# Что НЕ копируется в образ. Работает так же, как .gitignore, но для сборки.
#
# Самое важное — файл базы и секреты. Если локальная база уедет в образ,
# на сервере она перезапишет ту, в которой уже есть данные, причём молча,
# при обычном обновлении.

# Секреты и локальная конфигурация
.env
.env.*
!.env.example

# Файл базы и служебные журналы SQLite
data
backup
*.db
*.db-*
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Зависимости (на сервере не нужны: их нет у проекта, а node_modules
# собрался бы под другую систему)
node_modules

# История Git
.git
.gitignore
.gitattributes

# Сама сборка и служебные файлы
Dockerfile
.dockerignore
docker-compose.yml
*.log

# Материалы курса и рабочие документы — в работающем приложении не нужны
docs
prototype
Task_*
Урок *
Шаблон *
Библиотека промптов*
*.docx

# IDE и окружение разработчика
.idea
.vscode
.venv
venv
env
*.iml
Thumbs.db
.DS_Store
