# Пример файла переменных окружения.
# Скопируйте его в .env и подставьте свои значения:  cp .env.example .env
# Файл .env НИКОГДА не отправляется в репозиторий — он в .gitignore.
#
# В .env лежат ТОЛЬКО секреты и параметры окружения компьютера.
# Настройки продукта, которые меняет администратор студии
# (часовой пояс, адрес, часы работы), хранятся в таблице salon.

# --- Окружение ---
# development | production
NODE_ENV=development

# Порт HTTP-сервера
PORT=3000

# --- База данных ---
# Путь к файлу SQLite. Файл создаётся автоматически миграцией.
DB_FILE=./data/app.db

# --- Токены доступа ---
# Сколько часов действует токен после входа
TOKEN_TTL_HOURS=24

# --- Защита от подбора пароля ---
# Сколько неудачных попыток входа допустимо за окно RATE_LIMIT_WINDOW_MIN
RATE_LIMIT_ATTEMPTS=5
# Размер окна в минутах
RATE_LIMIT_WINDOW_MIN=15

# --- Временное удержание слота при оформлении ---
# Сколько секунд клиент держит выбранный слот, пока подтверждает запись
HOLD_TTL_SEC=300

# --- Доверие заголовку X-Forwarded-For ---
# 0 (по умолчанию) — сервер верит адресу сокета. Ставьте 1 только если
# сервер стоит за своим прокси (nginx на Beget); иначе заголовок можно
# подделать и обойти лимиты попыток входа.
TRUST_PROXY=0

# --- Вход через «Яндекс» ---
# Идентификатор и секрет приложения берутся в кабинете https://oauth.yandex.ru.
# Адрес возврата должен совпадать с указанным в кабинете приложения, иначе
# «Яндекс» вернёт ошибку redirect_uri. Пример для боевого домена:
#   YANDEX_REDIRECT_URI=https://portfolio-evratal-1.ru/api/auth/yandex/callback
# Если хотя бы одно значение не задано, вход через «Яндекс» выключен.
# Эти значения — секрет: они задаются в панели сервера, а не в репозитории.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=
